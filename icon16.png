$dir = "gold-dollar-extension"
if (Test-Path $dir) { Remove-Item -Recurse -Force $dir }
New-Item -ItemType Directory -Path $dir | Out-Null

# 1. manifest.json
@'
{
  "manifest_version": 3,
  "name": "ئالتۇن دۇللار باھاسى",
  "version": "1.2.0",
  "description": "خەلقئارالىق ئالتۇن، دوللار ۋە سۈرىيە رەسمىي پۇل كۆرسەتكۈچىنىڭ كۈندىلىك ئەھۋالى.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ئالتۇن دۇللار باھاسى",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["bg.png", "icon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
'@ | Out-File -FilePath "$dir\manifest.json" -Encoding utf8

# 2. icon.png ۋە bg.png ھاسىل قىلىش (PNG Base64)
$iconBase64 = ""
[System.IO.File]::WriteAllBytes("$dir\icon.png", [System.Convert]::FromBase64String($iconBase64))
[System.IO.File]::WriteAllBytes("$dir\bg.png", [System.Convert]::FromBase64String($iconBase64))

# 3. zip ھۆججەت چىقىرىش
Compress-Archive -Path "$dir\*" -DestinationPath "gold-dollar-extension.zip" -Force
Write-Host "تەييار بولدى! gold-dollar-extension.zip ھۆججىتى پۈتتى." -ForegroundColor Green